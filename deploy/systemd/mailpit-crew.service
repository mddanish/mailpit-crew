[Unit]
Description=MailPit-Crew (runs and manages Mailpit)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/mailpit-crew/mailpit-crew --config /opt/mailpit-crew/config.yaml
WorkingDirectory=/opt/mailpit-crew
Restart=always
RestartSec=5
SyslogIdentifier=mailpit-crew
User=root
Group=root
# Crew starts Mailpit through mailpit/ctl.sh. With KillMode=process, Mailpit
# keeps running while Crew restarts or upgrades; stop it with
# "/opt/mailpit-crew/mailpit/ctl.sh stop". Remove this line to stop Mailpit
# together with Crew.
KillMode=process

[Install]
WantedBy=multi-user.target
